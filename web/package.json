{
  "name": "apple2e-keyboard",
  "version": "1.0.0",
  "private": true,
  "description": "Apple //e keyboard, console and hardware debugger, over the BL616 USB-serial bridge",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "bridge": "node bridge/bridge.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pages": "node scripts/pages.mjs",
    "pages:check": "node scripts/pages.mjs --check",
    "preview": "vite preview",
    "charset": "node scripts/charset.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serialport": "^13.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
